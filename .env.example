# Скопируйте в .env.local и заполните значениями dev-проекта Supabase. Значения в git не коммитим.
# В Vercel те же переменные вносятся в настройки проектов web и api.

# --- Supabase (Project Settings → API / Data API) ---
SUPABASE_URL=
# Публичный ключ (anon / publishable) — нужен только web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секретный ключ (service_role / secret) — только api, для приглашений
SUPABASE_SERVICE_ROLE_KEY=

# --- База (Project Settings → Database → Connection string) ---
# Transaction pooler, порт 6543 — для api
DATABASE_URL=
# Session pooler или direct, порт 5432 — для миграций и сида
DATABASE_URL_DIRECT=

# --- api ---
PORT=4000
# Адрес кабинета; несколько — через запятую
WEB_ORIGIN=http://localhost:3000
# Необязательно: регулярка для preview-доменов web на Vercel, например lidomer-web-[a-z0-9-]+\.vercel\.app с https://
WEB_ORIGIN_PATTERN=
LOG_LEVEL=info

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- сид (pnpm db:seed) ---
SEED_WORKSPACE_NAME=
SEED_OWNER_EMAIL=

# --- Следующие этапы (пока не нужны) ---
# ENCRYPTION_KEY=          # openssl rand -base64 32
# CRON_SECRET=
# TELEGRAM_BOT_TOKEN=
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
