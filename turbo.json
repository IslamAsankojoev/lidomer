{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"],
      "passThroughEnv": [
        "SUPABASE_*",
        "DATABASE_URL",
        "WEB_ORIGIN",
        "WEB_ORIGIN_PATTERN",
        "LOG_LEVEL",
        "ENCRYPTION_KEY",
        "CRON_SECRET",
        "META_*"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["*"]
    }
  }
}
